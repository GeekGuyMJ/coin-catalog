# Serve sections.json as JSON for the /api/coins/sections endpoint so
# direct API consumers (curl, external scripts) get valid JSON instead of
# the HTML 404 page Cloudflare serves for _routes 404s.
/api/coins/sections /sections.json 200
/api/coins/* /api/coins/:splat 404
# Exclude /api/* from SPA fallback - do NOT add catch-all 200 rule for /api/*